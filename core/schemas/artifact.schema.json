{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://factory.gaddigital.io/schemas/artifact.schema.json",
  "type": "object",
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "artifactType"
  ],
  "properties": {
    "apiVersion": {
      "const": "factory.gaddigital.io/v1alpha1"
    },
    "kind": {
      "const": "Artifact"
    },
    "metadata": {
      "$ref": "common.schema.json#/$defs/metadata"
    },
    "artifactType": {
      "type": "string"
    },
    "execution": {
      "type": "string"
    },
    "task": {
      "type": "string"
    },
    "location": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "contentHash": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
