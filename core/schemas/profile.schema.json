{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aief.dev/schemas/profile.schema.json",
  "type": "object",
  "required": [
    "apiVersion",
    "kind",
    "metadata"
  ],
  "properties": {
    "apiVersion": {
      "const": "aief.dev/v1alpha1"
    },
    "kind": {
      "const": "Profile"
    },
    "metadata": {
      "$ref": "common.schema.json#/$defs/metadata"
    },
    "extends": {
      "$ref": "common.schema.json#/$defs/stringArray"
    },
    "discovery": {
      "type": "object",
      "additionalProperties": true
    },
    "commands": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "items": {"type": "string", "minLength": 1}
      }
    },
    "aggregate": {
      "description": "Validation of several modules sharing one build root. Commands run once at the root; {modules} is replaced by the comma-separated module paths.",
      "type": "object",
      "required": ["commands"],
      "properties": {
        "discovery": {"type": "object", "properties": {"files": {"type": "array", "items": {"type": "string", "minLength": 1}}}, "additionalProperties": false},
        "commands": {"type": "object", "additionalProperties": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}}
      },
      "additionalProperties": false
    },
    "practices": {
      "$ref": "common.schema.json#/$defs/stringArray"
    },
    "practiceRefs": {"$ref": "common.schema.json#/$defs/stringArray"},
    "policyRefs": {
      "$ref": "common.schema.json#/$defs/stringArray"
    },
    "standardRefs": {
      "$ref": "common.schema.json#/$defs/stringArray"
    },
    "policy": {"type":"object","properties":{"risk":{"$ref":"common.schema.json#/$defs/riskLevel"},"maximumAutonomy":{"$ref":"common.schema.json#/$defs/autonomyLevel"},"allowedActions":{"$ref":"common.schema.json#/$defs/stringArray"},"deniedActions":{"$ref":"common.schema.json#/$defs/stringArray"},"requiredGates":{"$ref":"common.schema.json#/$defs/stringArray"}},"additionalProperties":false}
  },
  "additionalProperties": false
}
