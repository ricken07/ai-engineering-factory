{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aief.dev/schemas/execution.schema.json",
  "type": "object",
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "project",
    "task",
    "workflow",
    "status"
  ],
  "properties": {
    "apiVersion": {
      "const": "aief.dev/v1alpha1"
    },
    "kind": {
      "const": "Execution"
    },
    "metadata": {
      "$ref": "common.schema.json#/$defs/metadata"
    },
    "project": {
      "type": "string"
    },
    "task": {
      "type": "string"
    },
    "workflow": {
      "type": "object",
      "required": [
        "id",
        "version"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "version": {
          "$ref": "common.schema.json#/$defs/semanticVersion"
        }
      },
      "additionalProperties": false
    },
    "agent": {
      "type": "object",
      "properties": {
        "adapter": {
          "type": "string"
        },
        "session": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "status": {
      "$ref": "common.schema.json#/$defs/executionStatus"
    },
    "policyDecision": {
      "type": "string"
    },
    "policyGates": {
      "type":"array",
      "items":{"type":"object","required":["id","status"],"properties":{"id":{"type":"string"},"status":{"enum":["pending","approved","rejected"]},"approvedAt":{"type":"string","format":"date-time"},"approvedBy":{"type":"string"}},"additionalProperties":false}
    },
    "risk": {
      "$ref": "common.schema.json#/$defs/riskLevel"
    },
    "autonomy": {
      "type": "object",
      "properties": {
        "requested": {
          "$ref": "common.schema.json#/$defs/autonomyLevel"
        },
        "authorized": {
          "$ref": "common.schema.json#/$defs/autonomyLevel"
        }
      },
      "additionalProperties": false
    },
    "repositories": {
      "$ref": "common.schema.json#/$defs/stringArray"
    },
    "phases": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "status": {
            "$ref": "common.schema.json#/$defs/executionStatus"
          },
          "skill": {"type": "string"},
          "gate": {"$ref": "gate.schema.json"},
          "artifacts": {
            "$ref": "common.schema.json#/$defs/stringArray"
          },
          "recovery": {
            "type": "object",
            "required": ["status", "attempts", "minimumAttempts", "maximumAttempts"],
            "properties": {
              "status": {"$ref": "common.schema.json#/$defs/recoveryStatus"},
              "minimumAttempts": {"type": "integer", "minimum": 1, "maximum": 15},
              "maximumAttempts": {"type": "integer", "minimum": 1, "maximum": 15},
              "attempts": {
                "type": "array",
                "maxItems": 15,
                "items": {
                  "type": "object",
                  "required": ["number", "error", "hypothesis", "action", "outcome"],
                  "properties": {
                    "number": {"type": "integer", "minimum": 1, "maximum": 15},
                    "error": {"type": "string"},
                    "hypothesis": {"type": "string"},
                    "action": {"type": "string"},
                    "outcome": {"type": "string"},
                    "evidence": {"$ref": "common.schema.json#/$defs/stringArray"}
                  },
                  "additionalProperties": false
                }
              },
              "question": {"type": "string"},
              "answer": {"type": "string"}
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    },
    "artifacts": {
      "$ref": "common.schema.json#/$defs/stringArray"
    },
    "blockingReason": {
      "type":"object", "required":["type","message"],
      "properties":{"type":{"type":"string"},"message":{"type":"string"},"task":{"type":"string"},"requiredBefore":{"type":"string"}},
      "additionalProperties":false
    },
    "cancelledReason": {
      "type": "string"
    },
    "traceability": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
