{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aief.dev/schemas/execution.schema.json",
  "type": "object",
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "project",
    "task",
    "workflow",
    "status"
  ],
  "properties": {
    "apiVersion": {
      "const": "aief.dev/v1alpha1"
    },
    "kind": {
      "const": "Execution"
    },
    "metadata": {
      "$ref": "common.schema.json#/$defs/metadata"
    },
    "project": {
      "type": "string"
    },
    "task": {
      "type": "string"
    },
    "workflow": {
      "type": "object",
      "required": [
        "id",
        "version"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "version": {
          "$ref": "common.schema.json#/$defs/semanticVersion"
        }
      },
      "additionalProperties": false
    },
    "agent": {
      "type": "object",
      "properties": {
        "adapter": {
          "type": "string"
        },
        "session": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "status": {
      "$ref": "common.schema.json#/$defs/executionStatus"
    },
    "policyDecision": {
      "type": "string"
    },
    "governedExecutionPlan": {"type":"string"},
    "roles": {"type":"object","properties":{"producer":{"$ref":"#/$defs/role"},"verifier":{"$ref":"#/$defs/role"},"reviewer":{"$ref":"#/$defs/role"},"approver":{"$ref":"#/$defs/role"}},"additionalProperties":false},
    "enforcementPoints": {"$ref": "common.schema.json#/$defs/stringArray"},
    "actors": {
      "type": "object",
      "properties": {
        "producer": {"$ref": "actor-identity.schema.json"},
        "verifier": {"$ref": "actor-identity.schema.json"},
        "reviewer": {"$ref": "actor-identity.schema.json"}
      },
      "additionalProperties": false
    },
    "review": {
      "type": "object",
      "required": ["independentRequired", "independence"],
      "properties": {
        "independentRequired": {"type": "boolean"},
        "independence": {"enum": ["INDEPENDENT", "NOT_INDEPENDENT", "UNVERIFIED", "NOT_REQUIRED"]}
      },
      "additionalProperties": false
    },
    "metrics": {"$ref": "experimental-metrics.schema.json"},
    "timingState": {
      "type": "object",
      "required": ["executionStartedMonotonicNs", "runtimeAccumulatedNs", "validationAccumulatedNs", "gateWaitingAccumulatedNs", "activeGateCount", "gateWaitingStartedMonotonicNs"],
      "properties": {
        "executionStartedMonotonicNs": {"type": ["integer", "null"]},
        "runtimeAccumulatedNs": {"type": "integer", "minimum": 0},
        "validationAccumulatedNs": {"type": "integer", "minimum": 0},
        "gateWaitingAccumulatedNs": {"type": "integer", "minimum": 0},
        "activeGateCount": {"type": "integer", "minimum": 0},
        "gateWaitingStartedMonotonicNs": {"type": ["integer", "null"]}
      },
      "additionalProperties": false
    },
    "reproducibility": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["value", "availability"],
        "properties": {
          "value": {"type": ["string", "integer", "object", "array", "null"]},
          "availability": {"enum": ["OBSERVED", "DERIVED", "UNAVAILABLE"]}
        },
        "additionalProperties": false
      }
    },
    "policyGates": {
      "type":"array",
      "items":{"type":"object","required":["id","status"],"properties":{"id":{"type":"string"},"status":{"enum":["pending","approved","rejected"]},"approvedAt":{"type":"string","format":"date-time"},"approvedBy":{"type":"string"},"actor":{"$ref":"actor-identity.schema.json"},"timing":{"$ref":"#/$defs/gateTiming"}},"additionalProperties":false}
    },
    "risk": {
      "$ref": "common.schema.json#/$defs/riskLevel"
    },
    "autonomy": {
      "type": "object",
      "properties": {
        "requested": {
          "$ref": "common.schema.json#/$defs/autonomyLevel"
        },
        "authorized": {
          "$ref": "common.schema.json#/$defs/autonomyLevel"
        }
      },
      "additionalProperties": false
    },
    "repositories": {
      "$ref": "common.schema.json#/$defs/stringArray"
    },
    "phases": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "status": {
            "$ref": "common.schema.json#/$defs/executionStatus"
          },
          "skill": {"type": "string"},
          "actorType": {"enum": ["runtime", "agent", "human", "provider"]},
          "timing": {"$ref": "#/$defs/phaseTiming"},
          "gateTiming": {"$ref": "#/$defs/gateTiming"},
          "gate": {"$ref": "gate.schema.json"},
          "artifacts": {
            "$ref": "common.schema.json#/$defs/stringArray"
          },
          "recovery": {
            "type": "object",
            "required": ["status", "attempts", "minimumAttempts", "maximumAttempts"],
            "properties": {
              "status": {"$ref": "common.schema.json#/$defs/recoveryStatus"},
              "minimumAttempts": {"type": "integer", "minimum": 1, "maximum": 15},
              "maximumAttempts": {"type": "integer", "minimum": 1, "maximum": 15},
              "attempts": {
                "type": "array",
                "maxItems": 15,
                "items": {
                  "type": "object",
                  "required": ["number", "error", "hypothesis", "action", "outcome"],
                  "properties": {
                    "number": {"type": "integer", "minimum": 1, "maximum": 15},
                    "error": {"type": "string"},
                    "hypothesis": {"type": "string"},
                    "action": {"type": "string"},
                    "outcome": {"type": "string"},
                    "evidence": {"$ref": "common.schema.json#/$defs/stringArray"}
                  },
                  "additionalProperties": false
                }
              },
              "question": {"type": "string"},
              "answer": {"type": "string"}
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    },
    "artifacts": {
      "$ref": "common.schema.json#/$defs/stringArray"
    },
    "blockingReason": {
      "type":"object", "required":["type","message"],
      "properties":{"type":{"type":"string"},"message":{"type":"string"},"task":{"type":"string"},"requiredBefore":{"type":"string"}},
      "additionalProperties":false
    },
    "cancelledReason": {
      "type": "string"
    },
    "traceability": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "role": {"type":"object","required":["type","identity"],"properties":{"type":{"enum":["agent","runtime","human"]},"identity":{"type":"string"},"session":{"type":"string"},"independentFromProducer":{"type":"boolean"}},"additionalProperties":false},
    "measurement": {
      "type": "object",
      "required": ["value", "availability"],
      "properties": {"value": {"type": ["integer", "null"]}, "availability": {"enum": ["OBSERVED", "DERIVED", "UNAVAILABLE"]}},
      "additionalProperties": false
    },
    "phaseTiming": {
      "type": "object",
      "required": ["startedAt", "completedAt", "durationMs"],
      "properties": {
        "startedAt": {"type": ["string", "null"], "format": "date-time"},
        "completedAt": {"type": ["string", "null"], "format": "date-time"},
        "durationMs": {"$ref": "#/$defs/measurement"},
        "startedMonotonicNs": {"type": "integer"}
      },
      "additionalProperties": false
    },
    "gateTiming": {
      "type": "object",
      "properties": {
        "gate": {"type": "string"},
        "requestedAt": {"type": ["string", "null"], "format": "date-time"},
        "decidedAt": {"type": ["string", "null"], "format": "date-time"},
        "durationMs": {"$ref": "#/$defs/measurement"},
        "startedMonotonicNs": {"type": "integer"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
