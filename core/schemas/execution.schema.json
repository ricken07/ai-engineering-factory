{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aief.dev/schemas/execution.schema.json",
  "type": "object",
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "project",
    "task",
    "workflow",
    "status"
  ],
  "properties": {
    "apiVersion": {
      "const": "aief.dev/v1alpha1"
    },
    "kind": {
      "const": "Execution"
    },
    "metadata": {
      "$ref": "common.schema.json#/$defs/metadata"
    },
    "project": {
      "type": "string"
    },
    "task": {
      "type": "string"
    },
    "workflow": {
      "type": "object",
      "required": [
        "id",
        "version"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "version": {
          "$ref": "common.schema.json#/$defs/semanticVersion"
        }
      },
      "additionalProperties": false
    },
    "agent": {
      "type": "object",
      "properties": {
        "adapter": {
          "type": "string"
        },
        "session": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "status": {
      "$ref": "common.schema.json#/$defs/executionStatus"
    },
    "policyDecision": {
      "type": "string"
    },
    "governedExecutionPlan": {"type":"string"},
    "roles": {"type":"object","properties":{"producer":{"$ref":"#/$defs/role"},"verifier":{"$ref":"#/$defs/role"},"reviewer":{"$ref":"#/$defs/role"},"approver":{"$ref":"#/$defs/role"}},"additionalProperties":false},
    "enforcementPoints": {"$ref": "common.schema.json#/$defs/stringArray"},
    "actors": {
      "type": "object",
      "properties": {
        "producer": {"$ref": "actor-identity.schema.json"},
        "verifier": {"$ref": "actor-identity.schema.json"},
        "reviewer": {"$ref": "actor-identity.schema.json"}
      },
      "additionalProperties": false
    },
    "review": {
      "type": "object",
      "required": ["independentRequired", "independence"],
      "properties": {
        "independentRequired": {"type": "boolean"},
        "independence": {"enum": ["INDEPENDENT", "NOT_INDEPENDENT", "UNVERIFIED", "NOT_REQUIRED"]}
      },
      "additionalProperties": false
    },
    "metrics": {"$ref": "experimental-metrics.schema.json"},
    "timingState": {
      "type": "object",
      "required": ["executionStartedMonotonicNs", "runtimeAccumulatedNs", "validationAccumulatedNs", "gateWaitingAccumulatedNs", "activeGateCount", "gateWaitingStartedMonotonicNs"],
      "properties": {
        "executionStartedMonotonicNs": {"type": ["integer", "null"]},
        "runtimeAccumulatedNs": {"type": "integer", "minimum": 0},
        "validationAccumulatedNs": {"type": "integer", "minimum": 0},
        "gateWaitingAccumulatedNs": {"type": "integer", "minimum": 0},
        "activeGateCount": {"type": "integer", "minimum": 0},
        "gateWaitingStartedMonotonicNs": {"type": ["integer", "null"]}
      },
      "additionalProperties": false
    },
    "gateDecisions": {
      "description": "Every human gate decision (approved, rejected, expired) with its timing, actor and the protocol it was taken under.",
      "type": "array",
      "items": {
        "type": "object",
        "required": ["gate", "kind", "decision", "at", "decidedAt"],
        "properties": {
          "gate": {"type": "string"},
          "kind": {"enum": ["phase-gate", "policy-gate"]},
          "decision": {"enum": ["approved", "rejected", "expired"]},
          "at": {"type": "string", "format": "date-time"},
          "phase": {"type": "string"},
          "trigger": {"type": "string"},
          "requestedAt": {"type": ["string", "null"]},
          "waitStartedAt": {"type": ["string", "null"]},
          "decidedAt": {"type": "string"},
          "waitDurationMs": {"$ref": "#/$defs/measurement"},
          "decisionRule": {"type": ["string", "null"]},
          "responseLimitMinutes": {"type": ["integer", "null"]},
          "rationale": {"type": "string"},
          "actor": {"type": "object", "properties": {"id": {"type": "string"}, "type": {"type": "string"}, "channel": {"type": "string"}, "assurance": {"type": "string"}}, "additionalProperties": false}
        },
        "additionalProperties": false
      }
    },
    "planBinding": {
      "description": "Plan and verification specification bound before the execution started. The Runtime copied them unchanged into the execution directory and records the planning phase from them.",
      "type": "object",
      "required": ["plan", "boundAt"],
      "properties": {
        "plan": {"$ref": "#/$defs/boundFile"},
        "verification": {"$ref": "#/$defs/boundFile"},
        "boundAt": {"type": "string", "format": "date-time"}
      },
      "additionalProperties": false
    },
    "reproducibility": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["value", "availability"],
        "properties": {
          "value": {"type": ["string", "integer", "object", "array", "null"]},
          "availability": {"enum": ["OBSERVED", "DERIVED", "UNAVAILABLE"]}
        },
        "additionalProperties": false
      }
    },
    "reworks": {
      "description": "Returns to implementation after a review that did not approve the change. The superseded artifacts keep a -rework-N suffix.",
      "type": "array",
      "items": {"type": "object", "required": ["number", "at", "review", "decision"], "properties": {"number": {"type": "integer", "minimum": 1}, "at": {"type": "string", "format": "date-time"}, "review": {"type": "string"}, "decision": {"type": "string"}, "findings": {"type": "array"}, "archived": {"type": "array", "items": {"type": "string"}}, "phases": {"type": "array", "items": {"type": "string"}}, "overruledAt": {"type": "string", "format": "date-time"}, "proposal": {"type": "object"}, "applyGate": {"type": "object"}}, "additionalProperties": false}
    },
    "findingDecisions": {
      "description": "Human decisions on blocking findings of an independent review, bound to the review artifact they answer.",
      "type": "array",
      "items": {"type": "object", "required": ["review", "reviewSha256", "finding", "decision", "justification", "at", "actor"], "properties": {"review": {"type": "string"}, "reviewSha256": {"type": "string"}, "finding": {"type": "integer", "minimum": 1}, "summary": {"type": "string"}, "decision": {"enum": ["not-blocking"]}, "justification": {"type": "string", "minLength": 1}, "at": {"type": "string", "format": "date-time"}, "actor": {"$ref": "actor-identity.schema.json"}}, "additionalProperties": false}
    },
    "approvalRefusals": {
      "description": "Human gate approvals the Runtime refused, kept as evidence (for example an approval relayed by an agent session).",
      "type": "array",
      "items": {"type": "object", "required": ["gate", "at", "reason"], "properties": {"gate": {"type": "string"}, "at": {"type": "string", "format": "date-time"}, "reason": {"type": "string"}, "relayedBy": {"type": "string"}, "approver": {"type": "string"}, "channel": {"type": "string"}}, "additionalProperties": false}
    },
    "policyGates": {
      "type":"array",
      "items":{"type":"object","required":["id","status"],"properties":{"id":{"type":"string"},"status":{"enum":["pending","approved","rejected","expired","not-triggered","withdrawn"]},"trigger":{"type":["string","null"]},"approvedAt":{"type":"string","format":"date-time"},"approvedBy":{"type":"string"},"actor":{"$ref":"actor-identity.schema.json"},"timing":{"$ref":"#/$defs/gateTiming"}},"additionalProperties":false}
    },
    "risk": {
      "$ref": "common.schema.json#/$defs/riskLevel"
    },
    "autonomy": {
      "type": "object",
      "properties": {
        "requested": {
          "$ref": "common.schema.json#/$defs/autonomyLevel"
        },
        "authorized": {
          "$ref": "common.schema.json#/$defs/autonomyLevel"
        }
      },
      "additionalProperties": false
    },
    "repositories": {
      "$ref": "common.schema.json#/$defs/stringArray"
    },
    "handoffs": {
      "description": "Sessions that handed the execution off; a reviewer is independent only after the producer handed off.",
      "type": "array",
      "items": {"type": "object", "required": ["from", "at"], "properties": {"from": {"type": "string"}, "at": {"type": "string"}}, "additionalProperties": false}
    },
    "proposal": {
      "description": "Change proposed as patches when modify-local-files is denied; the Runtime applies it through the apply-proposal gate.",
      "type": "object",
      "required": ["status", "baseline"],
      "properties": {
        "status": {"enum": ["pending", "proposed", "applied"]},
        "baseline": {"description": "Workspace fingerprint per Git root when the implementation started.", "type": "object", "additionalProperties": {"type": "string"}},
        "patches": {"type": "array", "items": {"type": "object", "required": ["repository", "root", "path", "sha256"], "properties": {"repository": {"type": "string"}, "root": {"type": "string"}, "path": {"type": "string"}, "sha256": {"type": "string"}}, "additionalProperties": false}},
        "appliedAt": {"type": "string"},
        "appliedBy": {"type": "string"},
        "approvedBy": {"type": "string"}
      },
      "additionalProperties": false
    },
    "impactPaths": {
      "description": "Paths listed by the impact analysis; they scope path-restricted critical domains.",
      "$ref": "common.schema.json#/$defs/stringArray"
    },
    "phases": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "status": {
            "$ref": "common.schema.json#/$defs/executionStatus"
          },
          "skill": {"type": "string"},
          "actorType": {"enum": ["runtime", "agent", "human", "provider"]},
          "timing": {"$ref": "#/$defs/phaseTiming"},
          "gateTiming": {"$ref": "#/$defs/gateTiming"},
          "gate": {"$ref": "gate.schema.json"},
          "artifacts": {
            "$ref": "common.schema.json#/$defs/stringArray"
          },
          "preparedAt": {
            "description": "When the Runtime started the phase (execution next). A phase it did not start cannot be completed.",
            "type": "string"
          },
          "rework": {
            "description": "Set on the implementation phase reopened after a review that did not approve the change: the findings to address.",
            "type": "object", "required": ["number", "review"],
            "properties": {"number": {"type": "integer", "minimum": 1}, "review": {"type": "string"}, "decision": {"type": "string"}, "findings": {"type": "array"}},
            "additionalProperties": false
          },
          "action": {
            "description": "Action the implementation phase may perform under the governed plan: modify-local-files, or propose-change when local modification is denied.",
            "enum": ["modify-local-files", "propose-change"]
          },
          "recovery": {
            "type": "object",
            "required": ["status", "attempts", "minimumAttempts", "maximumAttempts"],
            "properties": {
              "status": {"$ref": "common.schema.json#/$defs/recoveryStatus"},
              "minimumAttempts": {"type": "integer", "minimum": 1, "maximum": 15},
              "maximumAttempts": {"type": "integer", "minimum": 1, "maximum": 15},
              "attempts": {
                "type": "array",
                "maxItems": 15,
                "items": {
                  "type": "object",
                  "required": ["number", "error", "hypothesis", "action", "outcome"],
                  "properties": {
                    "number": {"type": "integer", "minimum": 1, "maximum": 15},
                    "error": {"type": "string"},
                    "hypothesis": {"type": "string"},
                    "action": {"type": "string"},
                    "outcome": {"type": "string"},
                    "evidence": {"$ref": "common.schema.json#/$defs/stringArray"}
                  },
                  "additionalProperties": false
                }
              },
              "question": {"type": "string"},
              "answer": {"type": "string"}
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    },
    "artifacts": {
      "$ref": "common.schema.json#/$defs/stringArray"
    },
    "blockingReason": {
      "type":"object", "required":["type","message"],
      "properties":{"type":{"type":"string"},"message":{"type":"string"},"task":{"type":"string"},"requiredBefore":{"type":"string"}},
      "additionalProperties":false
    },
    "cancelledReason": {
      "type": "string"
    },
    "traceability": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "boundFile": {"type":"object","required":["artifact","sha256"],"properties":{"artifact":{"type":"string","minLength":1},"sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"}},"additionalProperties":false},
    "role": {"type":"object","required":["type","identity"],"properties":{"type":{"enum":["agent","runtime","human"]},"identity":{"type":"string"},"session":{"type":"string"},"independentFromProducer":{"type":"boolean"}},"additionalProperties":false},
    "measurement": {
      "type": "object",
      "required": ["value", "availability"],
      "properties": {"value": {"type": ["integer", "null"]}, "availability": {"enum": ["OBSERVED", "DERIVED", "UNAVAILABLE"]}},
      "additionalProperties": false
    },
    "phaseTiming": {
      "type": "object",
      "required": ["startedAt", "completedAt", "durationMs"],
      "properties": {
        "startedAt": {"type": ["string", "null"], "format": "date-time"},
        "completedAt": {"type": ["string", "null"], "format": "date-time"},
        "durationMs": {"$ref": "#/$defs/measurement"},
        "startedMonotonicNs": {"type": "integer"}
      },
      "additionalProperties": false
    },
    "gateTiming": {
      "type": "object",
      "properties": {
        "gate": {"type": "string"},
        "requestedAt": {"type": ["string", "null"], "format": "date-time"},
        "decidedAt": {"type": ["string", "null"], "format": "date-time"},
        "blockedAt": {"type": "string", "format": "date-time"},
        "closedAt": {"type": "string", "format": "date-time"},
        "durationMs": {"$ref": "#/$defs/measurement"},
        "startedMonotonicNs": {"type": "integer"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
