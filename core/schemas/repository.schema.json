{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aief.dev/schemas/repository.schema.json",
  "type": "object",
  "required": [
    "id",
    "path",
    "role"
  ],
  "properties": {
    "id": {
      "$ref": "common.schema.json#/$defs/identifier"
    },
    "path": {
      "type": "string",
      "minLength": 1
    },
    "role": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "profiles": {
      "$ref": "common.schema.json#/$defs/stringArray"
    },
    "responsibilities": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "repository",
          "type"
        ],
        "properties": {
          "repository": {
            "$ref": "common.schema.json#/$defs/identifier"
          },
          "type": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "criticalDomains": {
      "$ref": "common.schema.json#/$defs/stringArray"
    },
    "policyRefs": {
      "$ref": "common.schema.json#/$defs/stringArray"
    },
    "engineering": {"$ref": "engineering-config.schema.json"}
    ,"git": {
      "type":"object",
      "properties": {
        "baseBranch":{"type":"string"},
        "taskBranchPrefix":{"type":"string"}
      },
      "additionalProperties":false
    }
  },
  "additionalProperties": false
}
