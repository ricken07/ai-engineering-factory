{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aief.dev/schemas/adapter.schema.json",
  "type": "object",
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "agent",
    "mappings"
  ],
  "properties": {
    "apiVersion": {
      "const": "aief.dev/v1alpha1"
    },
    "kind": {
      "const": "AgentAdapter"
    },
    "metadata": {
      "$ref": "common.schema.json#/$defs/metadata"
    },
    "agent": {
      "type": "string"
    },
    "bootstrap": {
      "type": "string"
    },
    "installation": {
      "type":"object",
      "required":["userSkillsDirectory","invocation"],
      "properties":{"userSkillsDirectory":{"type":"string"},"invocation":{"type":"string"},"linkMode":{"enum":["symlink","copy"]}},
      "additionalProperties":false
    },
    "mappings": {
      "type": "object",
      "properties": {
        "workflows": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "skills": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "capabilities": {
          "type":"object",
          "additionalProperties":{"type":"string"}
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
