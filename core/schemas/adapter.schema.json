{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://factory.gaddigital.io/schemas/adapter.schema.json",
  "type": "object",
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "agent",
    "mappings"
  ],
  "properties": {
    "apiVersion": {
      "const": "factory.gaddigital.io/v1alpha1"
    },
    "kind": {
      "const": "AgentAdapter"
    },
    "metadata": {
      "$ref": "common.schema.json#/$defs/metadata"
    },
    "agent": {
      "type": "string"
    },
    "bootstrap": {
      "type": "string"
    },
    "mappings": {
      "type": "object",
      "properties": {
        "workflows": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "skills": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
