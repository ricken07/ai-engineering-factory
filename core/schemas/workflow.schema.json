{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://factory.gaddigital.io/schemas/workflow.schema.json",
  "type": "object",
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "phases"
  ],
  "properties": {
    "apiVersion": {
      "const": "factory.gaddigital.io/v1alpha1"
    },
    "kind": {
      "const": "Workflow"
    },
    "metadata": {
      "$ref": "common.schema.json#/$defs/metadata"
    },
    "inputs": {
      "$ref": "common.schema.json#/$defs/stringArray"
    },
    "phases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "skill"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "skill": {
            "type": "string"
          },
          "required": {
            "type": "boolean",
            "default": true
          },
          "gate": {
            "$ref": "gate.schema.json"
          }
        },
        "additionalProperties": false
      }
    },
    "outputs": {
      "$ref": "common.schema.json#/$defs/stringArray"
    },
    "policyRefs": {
      "$ref": "common.schema.json#/$defs/stringArray"
    }
  },
  "additionalProperties": false
}
