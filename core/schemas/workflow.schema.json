{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aief.dev/schemas/workflow.schema.json",
  "type": "object",
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "phases"
  ],
  "properties": {
    "apiVersion": {
      "const": "aief.dev/v1alpha1"
    },
    "kind": {
      "const": "Workflow"
    },
    "metadata": {
      "$ref": "common.schema.json#/$defs/metadata"
    },
    "inputs": {
      "$ref": "common.schema.json#/$defs/stringArray"
    },
    "phases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "skill"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "skill": {
            "type": "string"
          },
          "required": {
            "type": "boolean",
            "default": true
          },
          "gate": {
            "$ref": "gate.schema.json"
          },
          "recovery": {
            "type": "object",
            "properties": {
              "minimumAttempts": {"type": "integer", "minimum": 1, "maximum": 15, "default": 10},
              "maximumAttempts": {"type": "integer", "minimum": 1, "maximum": 15, "default": 15}
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    },
    "outputs": {
      "$ref": "common.schema.json#/$defs/stringArray"
    },
    "policyRefs": {
      "$ref": "common.schema.json#/$defs/stringArray"
    }
  },
  "additionalProperties": false
}
