{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aief.dev/schemas/payload-ledger.schema.json",
  "title": "PayloadLedger",
  "description": "What the Runtime delivered to the agent each time it prepared a phase: snapshots, hashes and classification of the information carried.",
  "type": "object",
  "required": ["apiVersion", "kind", "metadata", "task", "execution", "experimentalCondition", "entries", "fingerprint"],
  "properties": {
    "apiVersion": {"type": "string"},
    "kind": {"const": "PayloadLedger"},
    "metadata": {"type": "object", "required": ["id"], "properties": {"id": {"type": "string", "minLength": 1}}, "additionalProperties": false},
    "task": {"type": "string", "minLength": 1},
    "execution": {"type": "string", "minLength": 1},
    "experimentalCondition": {"type": ["string", "null"]},
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["sequence", "phase", "skill", "attempt", "at", "items", "fingerprint"],
        "properties": {
          "sequence": {"type": "integer", "minimum": 1},
          "phase": {"type": "string"},
          "skill": {"type": "string"},
          "attempt": {"type": "integer", "minimum": 0, "description": "Rework number of the phase; 0 for its first pass."},
          "at": {"type": "string", "format": "date-time"},
          "items": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/item"}},
          "fingerprint": {"$ref": "#/$defs/fingerprint"}
        },
        "additionalProperties": false
      }
    },
    "fingerprint": {"$ref": "#/$defs/fingerprint"}
  },
  "additionalProperties": false,
  "$defs": {
    "fingerprint": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "classification": {"enum": ["procedural", "project-context", "task-context", "task-plan", "review-feedback", "human-decision", "runtime-state", "unclassified"]},
    "item": {
      "type": "object",
      "required": ["kind", "base", "path", "sha256", "bytes", "classification"],
      "properties": {
        "kind": {"enum": ["phase-brief", "execution-next-output", "skill-instructions", "skill-manifest", "output-schema", "output-contract", "bound-plan", "bound-verification"]},
        "base": {"enum": ["execution", "factory", "project", "absolute"]},
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "bytes": {"type": "integer", "minimum": 0},
        "classification": {"$ref": "#/$defs/classification"},
        "sections": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "heading", "classification", "sha256", "bytes"],
            "properties": {
              "id": {"type": "string"},
              "heading": {"type": "string"},
              "classification": {"$ref": "#/$defs/classification"},
              "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
              "bytes": {"type": "integer", "minimum": 0}
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  }
}
