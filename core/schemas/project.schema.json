{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aief.dev/schemas/project.schema.json",
  "type": "object",
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "factory",
    "workspace",
    "repositories"
  ],
  "properties": {
    "apiVersion": {
      "const": "aief.dev/v1alpha1"
    },
    "kind": {
      "const": "Project"
    },
    "metadata": {
      "$ref": "common.schema.json#/$defs/metadata"
    },
    "factory": {
      "type": "object",
      "required": [
        "version"
      ],
      "properties": {
        "version": {
          "$ref": "common.schema.json#/$defs/semanticVersion"
        },
        "homeEnv": {
          "type": "string",
          "default": "GAD_AI_FACTORY_HOME"
        }
      },
      "additionalProperties": false
    },
    "workspace": {
      "type": "object",
      "required": [
        "strategy"
      ],
      "properties": {
        "strategy": {
          "type": "string",
          "enum": [
            "monorepo",
            "polyrepo"
          ]
        },
        "root": {
          "type": "string",
          "default": "."
        }
      },
      "additionalProperties": false
    },
    "workspaceSafety": {
      "type": "object",
      "properties": {
        "mode": {"type":"string", "enum":["require-clean", "worktree"], "default":"require-clean"},
        "baseBranch": {"type":"string", "default":"main"},
        "taskBranchPrefix": {"type":"string", "default":"aief"}
      },
      "additionalProperties": false
    },
    "repositories": {
      "type": "array",
      "items": {
        "$ref": "repository.schema.json"
      },
      "minItems": 1
    },
    "context": {
      "type": "object",
      "properties": {
        "project": {
          "type": "string"
        },
        "architecture": {
          "type": "string"
        },
        "domain": {
          "type": "string"
        },
        "conventions": {
          "type": "string"
        },
        "decisions": {
          "type": "string"
        },
        "memory": {
          "type": "string"
        },
        "memoryPatterns": {"type": "string"},
        "knownConstraints": {"type": "string"},
        "lessons": {"type": "string"}
      },
      "additionalProperties": false
    },
    "runtime": {
      "type": "object",
      "properties": {
        "root": {"type":"string", "default":".ai/runtime"},
        "taskRetentionDays": {"type":"integer", "minimum":1, "default":30},
        "executionRetentionDays": {"type":"integer", "minimum":1, "default":14},
        "durableTaskSystem": {"type":"string"}
        }
      ,"additionalProperties": false
    },
    "integrations": {
      "type": "object",
      "additionalProperties": {
        "oneOf": [
          {"type": "string"},
          {"type":"object", "required":["provider"], "properties":{"provider":{"type":"string"}}, "additionalProperties":false}
        ]
      }
    },
    "integrationLock": {"type":"string", "default":".ai/integration-lock.yaml"},
    "taskTracking": {
      "type": "object",
      "properties": {
        "mode": {
          "type": "string",
          "enum": ["local", "external"],
          "default": "external"
        },
        "namespace": {"type":"string", "minLength":1},
        "referenceFormat": {"enum":["provider-native","container-iid","url"]},
        "workflowStates": {"type":"array","items":{"type":"string","minLength":1},"uniqueItems":true},
        "defaultLabels": {"$ref":"common.schema.json#/$defs/stringArray"}
      },
      "additionalProperties": false
    },
    "engineering": {"$ref": "engineering-config.schema.json"},
    "autonomy": {
      "type": "object",
      "properties": {
        "default": {
          "$ref": "common.schema.json#/$defs/autonomyLevel"
        },
        "maximum": {
          "$ref": "common.schema.json#/$defs/autonomyLevel"
        }
      },
      "additionalProperties": false
    },
    "policyRefs": {
      "$ref": "common.schema.json#/$defs/stringArray"
    }
  },
  "additionalProperties": false
}
