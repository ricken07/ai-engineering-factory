{
  "$schema":"https://json-schema.org/draft/2020-12/schema", "$id":"https://aief.dev/schemas/task-tracking-decision.schema.json",
  "type":"object", "required":["apiVersion","kind","metadata","task","decision","reasons","requiredBefore","provider","duplicateSearch","externalTracking"],
  "properties":{
