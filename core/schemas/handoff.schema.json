{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://factory.gaddigital.io/schemas/handoff.schema.json",
  "type": "object",
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "task",
    "status",
    "summary"
  ],
  "properties": {
    "apiVersion": {
      "const": "factory.gaddigital.io/v1alpha1"
    },
    "kind": {
      "const": "Handoff"
    },
    "metadata": {
      "$ref": "common.schema.json#/$defs/metadata"
    },
    "task": {
      "type": "string"
    },
    "execution": {
      "type": "string"
    },
    "status": {
      "$ref": "common.schema.json#/$defs/executionStatus"
    },
    "summary": {
      "type": "string"
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "artifacts": {
      "$ref": "common.schema.json#/$defs/stringArray"
    },
    "openQuestions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "nextActions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
