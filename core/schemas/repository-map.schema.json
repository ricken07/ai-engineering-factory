{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aief.dev/schemas/repository-map.schema.json",
  "type": "object",
  "required": ["apiVersion", "kind", "metadata", "repositories", "relationships"],
  "properties": {
    "apiVersion": {"const": "aief.dev/v1alpha1"},
    "kind": {"const": "RepositoryMap"},
    "metadata": {"$ref": "common.schema.json#/$defs/metadata"},
    "repositories": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "responsibilities": {"$ref": "common.schema.json#/$defs/stringArray"},
          "exposes": {"$ref": "common.schema.json#/$defs/stringArray"},
          "consumes": {"$ref": "common.schema.json#/$defs/stringArray"}
        },
        "additionalProperties": false
      }
    },
    "relationships": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["from", "to", "type"],
        "properties": {"from": {"type": "string"}, "to": {"type": "string"}, "type": {"type": "string"}},
        "additionalProperties": false
      }
    },
    "criticalDomains": {"$ref": "common.schema.json#/$defs/stringArray"}
  },
  "additionalProperties": false
}
