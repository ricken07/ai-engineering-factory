{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://factory.gaddigital.io/schemas/gate.schema.json",
  "type": "object",
  "required": [
    "id",
    "type"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "policy",
        "human-approval",
        "validation",
        "external"
      ]
    },
    "policy": {
      "type": "string"
    },
    "condition": {
      "type": "object"
    },
    "description": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
