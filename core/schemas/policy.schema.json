{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://factory.gaddigital.io/schemas/policy.schema.json",
  "type": "object",
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "rules"
  ],
  "properties": {
    "apiVersion": {
      "const": "factory.gaddigital.io/v1alpha1"
    },
    "kind": {
      "const": "Policy"
    },
    "metadata": {
      "$ref": "common.schema.json#/$defs/metadata"
    },
    "scope": {
      "type": "string",
      "enum": [
        "factory",
        "profile",
        "project",
        "repository",
        "task"
      ]
    },
    "priority": {
      "type": "integer",
      "minimum": 0
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "effect"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "when": {
            "type": "object"
          },
          "before": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "effect": {
            "type": "object"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
