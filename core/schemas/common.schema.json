{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aief.dev/schemas/common.schema.json",
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "semanticVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"
    },
    "riskLevel": {
      "type": "string",
      "enum": [
        "unknown",
        "low",
        "medium",
        "high",
        "critical"
      ]
    },
    "autonomyLevel": {
      "type": "string",
      "enum": [
        "L0",
        "L1",
        "L2",
        "L3",
        "L4"
      ]
    },
    "executionStatus": {
      "type": "string",
      "enum": [
        "pending",
        "running",
        "blocked",
        "waiting-approval",
        "completed",
        "failed",
        "cancelled"
      ]
    },
    "recoveryStatus": {
      "type": "string",
      "enum": ["active", "resolved", "waiting-user", "exhausted"]
    },
    "metadata": {
      "type": "object",
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "version": {
          "$ref": "#/$defs/semanticVersion"
        }
      },
      "additionalProperties": false
    },
    "stringArray": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    }
  }
}
