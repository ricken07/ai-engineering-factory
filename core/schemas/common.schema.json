{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aief.dev/schemas/common.schema.json",
  "$defs": {
    "outputContracts": {
      "description": "Extra JSON Schemas a Skill output must satisfy, on top of the Core output schema.",
      "type": "array",
      "items": {
        "type": "object",
        "required": ["skill", "schema"],
        "properties": {"skill": {"$ref": "#/$defs/identifier"}, "schema": {"type": "string", "minLength": 1}},
        "additionalProperties": false
      }
    },
    "riskRules": {
      "description": "Layered risk rules: they can only raise the effective risk (riskAtLeast), never lower it.",
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "when", "effect"],
        "properties": {
          "id": {"$ref": "#/$defs/identifier"},
          "description": {"type": "string"},
          "when": {
            "type": "object",
            "minProperties": 1,
            "properties": {
              "domains": {"type": "object", "required": ["containsAny"], "properties": {"containsAny": {"$ref": "#/$defs/stringArray"}}, "additionalProperties": false},
              "changeTypes": {"type": "object", "required": ["containsAny"], "properties": {"containsAny": {"$ref": "#/$defs/stringArray"}}, "additionalProperties": false}
            },
            "additionalProperties": false
          },
          "effect": {"type": "object", "required": ["riskAtLeast"], "properties": {"riskAtLeast": {"$ref": "#/$defs/riskLevel"}}, "additionalProperties": false}
        },
        "additionalProperties": false
      }
    },
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "semanticVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"
    },
    "riskLevel": {
      "type": "string",
      "enum": [
        "unknown",
        "low",
        "medium",
        "high",
        "critical"
      ]
    },
    "autonomyLevel": {
      "type": "string",
      "enum": [
        "L0",
        "L1",
        "L2",
        "L3",
        "L4"
      ]
    },
    "executionStatus": {
      "type": "string",
      "enum": [
        "pending",
        "running",
        "blocked",
        "waiting-approval",
        "completed",
        "failed",
        "cancelled"
      ]
    },
    "recoveryStatus": {
      "type": "string",
      "enum": ["active", "resolved", "waiting-user", "exhausted"]
    },
    "metadata": {
      "type": "object",
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "version": {
          "$ref": "#/$defs/semanticVersion"
        }
      },
      "additionalProperties": false
    },
    "criticalDomains": {
      "description": "Domains a repository makes critical. A string applies to every task touching the repository; an object applies only when the impact analysis touches one of its paths (globs relative to the repository path), or lists no path in that repository.",
      "type": "array",
      "items": {
        "oneOf": [
          {"type": "string", "minLength": 1},
          {
            "type": "object",
            "required": ["domain", "paths"],
            "properties": {
              "domain": {"type": "string", "minLength": 1},
              "paths": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
            },
            "additionalProperties": false
          }
        ]
      }
    },
    "stringArray": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    }
  }
}
