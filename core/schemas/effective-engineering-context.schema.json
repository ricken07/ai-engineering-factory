{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aief.dev/schemas/effective-engineering-context.schema.json",
  "type": "object",
  "required": ["apiVersion", "kind", "metadata", "project", "repository", "skill", "profiles", "profileResolutions", "organizationCatalogs", "categories", "practices", "resolutions", "taskContext", "fingerprint"],
  "properties": {
    "apiVersion": {"const": "aief.dev/v1alpha1"},
    "kind": {"const": "EffectiveEngineeringContext"},
    "metadata": {"$ref": "common.schema.json#/$defs/metadata"},
    "project": {"type": "string"},
    "repository": {"type": "string"},
    "skill": {"type": "string"},
    "task": {"type":"string"},
    "fingerprint": {"type":"string","pattern":"^[a-f0-9]{64}$"},
    "profiles": {"$ref": "common.schema.json#/$defs/stringArray"},
    "profileResolutions": {"type":"array","items":{"type":"object","required":["id","version","source"],"properties":{"id":{"type":"string"},"version":{"$ref":"common.schema.json#/$defs/semanticVersion"},"source":{"type":"string"},"extends":{"$ref":"common.schema.json#/$defs/stringArray"}},"additionalProperties":false}},
    "organizationCatalogs": {"type":"array","items":{"type":"object","required":["id","version","source"],"properties":{"id":{"type":"string"},"version":{"$ref":"common.schema.json#/$defs/semanticVersion"},"source":{"type":"string"},"extends":{"$ref":"common.schema.json#/$defs/stringArray"}},"additionalProperties":false}},
    "categories": {"$ref": "common.schema.json#/$defs/stringArray"},
    "practices": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "version", "category", "enforcement", "source", "document"],
        "properties": {
          "id": {"type": "string"}, "version": {"$ref": "common.schema.json#/$defs/semanticVersion"},
          "category": {"type": "string"}, "enforcement": {"type": "string"},
          "source": {"enum": ["organization", "project", "repository", "task"]},
          "document": {"type": "string"}, "content": {"type": "string"}, "overrides": {"type": "string"},
          "contentHash":{"type":"string","pattern":"^[a-f0-9]{64}$"},
          "provenance":{"type":"object","required":["source","document"],"properties":{"source":{"type":"string"},"document":{"type":"string"},"manifest":{"type":"string"}},"additionalProperties":false}
        },
        "additionalProperties": false
      }
    },
    "resolutions": {"type": "array", "items": {"type": "object"}},
    "taskContext": {
      "type":"object",
      "properties":{"objective":{"type":"object"},"scope":{"type":"object"},"classification":{"type":"object"},"constraints":{"$ref":"common.schema.json#/$defs/stringArray"}},
      "additionalProperties":false
    }
  },
  "additionalProperties": false
}
