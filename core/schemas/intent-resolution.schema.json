{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://factory.gaddigital.io/schemas/intent-resolution.schema.json",
  "type": "object",
  "required": ["apiVersion", "kind", "metadata", "request", "intent", "confidence", "source", "mutating", "workflow"],
  "properties": {
    "apiVersion": {"const": "factory.gaddigital.io/v1alpha1"},
    "kind": {"const": "IntentResolution"},
    "metadata": {"$ref": "common.schema.json#/$defs/metadata"},
    "request": {"type": "string"},
    "intent": {"enum": ["analyze", "implement", "fix", "refactor", "test", "review", "document", "promote"]},
    "confidence": {"enum": ["high", "medium", "low", "ambiguous"]},
    "source": {"enum": ["explicit-command", "explicit-language", "agent-classification", "conservative-fallback"]},
    "mutating": {"type": "boolean"},
    "workflow": {"type": "string"},
    "taskReference": {"type": "string"},
    "reason": {"type": "string"},
    "requiresClarification": {"type": "boolean"}
  },
  "additionalProperties": false
}
