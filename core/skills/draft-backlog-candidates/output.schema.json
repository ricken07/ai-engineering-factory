{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aief.dev/skills/draft-backlog-candidates/output.schema.json",
  "type": "object",
  "required": ["summary", "status", "evidence", "unknowns", "candidates", "openQuestions"],
  "properties": {
    "summary": {"type": "string", "minLength": 1},
    "status": {"enum": ["completed", "blocked", "failed"]},
    "evidence": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "unknowns": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "candidates": {"type": "array", "items": {"type": "object"}, "minItems": 1},
    "openQuestions": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
  },
  "additionalProperties": false
}
