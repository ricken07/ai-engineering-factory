{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://factory.gaddigital.io/skills/analyze-impact/output.schema.json",
  "type": "object",
  "required": ["summary", "status", "evidence", "unknowns", "details"],
  "properties": {
    "summary": {"type": "string", "minLength": 1},
    "status": {"enum": ["completed", "blocked", "failed"]},
    "evidence": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "unknowns": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "details": {
      "type": "object",
      "required": ["repositories"],
      "properties": {
        "repositories": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "risk": {"enum": ["unknown", "low", "medium", "high", "critical"]},
        "changeTypes": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "domains": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
