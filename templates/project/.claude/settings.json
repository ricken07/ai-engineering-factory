{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "Bash(printenv AI_FACTORY_HOME)",
      "Bash(aief *)",
      "Bash(aief validate *)",
      "Bash(aief doctor *)",
      "Bash(aief inspect *)",
      "Bash(aief run *)",
      "Bash(aief task inspect *)",
      "Bash(aief task assess-tracking *)",
      "Bash(aief task tracking *)",
      "Bash(aief task search-external *)",
      "Bash(aief execution inspect *)",
      "Bash(aief execution next *)",
      "Bash(aief execution engineering-context *)",
      "Bash(aief execution profile-validation *)",
      "Bash(aief execution complete-phase *)",
      "Bash(aief execution lease *)",
      "Bash(aief workspace inspect *)",
      "Bash(aief workspace status *)",
      "Bash(aief workspace verify *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git rev-parse *)",
      "Bash(git branch --show-current)"
    ],
    "ask": [
      "Bash(aief execution approve *)",
      "Bash(aief execution approve-policy *)",
      "Bash(aief task create-external *)",
      "Bash(aief task link *)",
      "Bash(aief task operation-approval *)",
      "Bash(aief integrations sync * --execute*)",
      "Bash(aief workspace prepare * --execute*)",
      "Bash(aief workspace rollback * --execute*)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(git checkout *)",
      "Bash(git switch *)",
      "Bash(git restore *)",
      "Bash(git reset *)",
      "Bash(git stash *)",
      "Bash(git worktree *)",
      "Bash(git cherry-pick *)",
      "Bash(git pull *)",
      "Bash(git merge *)",
      "Bash(git rebase *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/secrets/**)",
      "Write(./factory.yaml)",
      "Edit(./factory.yaml)",
      "Bash(ln *factory.yaml*)",
      "Bash(git push --force*)",
      "Bash(git reset --hard*)",
      "Bash(git clean -f*)",
      "Bash(rm -rf *)"
    ]
  }
}
